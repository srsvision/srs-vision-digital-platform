PORT=3000
NODE_ENV=development
# Generate a long random secret; never commit your real .env
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=owner@example.com
# Generate a bcrypt hash with: node -e "require('bcryptjs').hash('YOUR_PASSWORD',12).then(console.log)"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
OWNER_NOTIFICATION_EMAIL=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# Optional later: AI provider key belongs on the server only
AI_PROVIDER_API_KEY=
